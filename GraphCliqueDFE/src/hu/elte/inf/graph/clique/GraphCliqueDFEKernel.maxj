package hu.elte.inf.graph.clique;

import com.maxeler.maxcompiler.v2.kernelcompiler.Kernel;
import com.maxeler.maxcompiler.v2.kernelcompiler.KernelParameters;
import com.maxeler.maxcompiler.v2.kernelcompiler.stdlib.Bitops;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.base.DFEType;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.base.DFEVar;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.composite.DFEVector;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.composite.DFEVectorType;

import static hu.elte.inf.graph.clique.InputKernel.NUM_ROWS;
import static hu.elte.inf.graph.clique.Utility.Pair;

public class GraphCliqueDFEKernel extends Kernel {
	public static final DFEType UINT64 = Kernel.dfeUInt(64);
	public static final DFEType UINT6 = Kernel.dfeUInt(6);
	public static final DFEType BOOL = Kernel.dfeBool();
	public static final DFEVectorType<DFEVar> ADJ_MATRIX_TYPE = 
			new DFEVectorType<DFEVar>(UINT64, NUM_ROWS);
	
	private static final int LOOP_LATENCY = 4;
	private static final int K = 5;
	
	@SuppressWarnings("deprecation")
	public GraphCliqueDFEKernel(final KernelParameters parameters) {
		super(parameters);

		DFEVar initialSubset0 = io.scalarInput("initialSubset0", UINT64);
		DFEVar initialSubset1 = io.scalarInput("initialSubset1", UINT64);
		DFEVar initialSubset2 = io.scalarInput("initialSubset2", UINT64);
		DFEVar initialSubset3 = io.scalarInput("initialSubset3", UINT64);
		DFEVar limit0 = io.scalarInput("limit0", UINT64);
		DFEVar limit1 = io.scalarInput("limit1", UINT64);
		DFEVar limit2 = io.scalarInput("limit2", UINT64);
		DFEVar limit3 = io.scalarInput("limit3", UINT64);
		
		DFEVector<DFEVar> adjMatrixRows = io.input("adjMatrix", ADJ_MATRIX_TYPE);
		
		DFEVar tick = control.count.simpleCounter(64);
		
		DFEVar hasLastBit = tick.slice(0, 1).cast(BOOL);
		DFEVar hasSecondToLastBit = tick.slice(1, 1).cast(BOOL);

		DFEVar tickModFourIsZero = ~hasLastBit & ~hasSecondToLastBit;
		DFEVar tickModFourIsOne = hasLastBit & ~hasSecondToLastBit;
		DFEVar tickModFourIsTwo = ~hasLastBit & hasSecondToLastBit;
		DFEVar tickModFourIsThree = hasLastBit & hasSecondToLastBit;
		
		DFEVar isFirstSubset0 = tick === constant.var(UINT64, 0);
		DFEVar isFirstSubset1 = tick === constant.var(UINT64, 1);
		DFEVar isFirstSubset2 = tick === constant.var(UINT64, 2);
		DFEVar isFirstSubset3 = tick === constant.var(UINT64, 3);
		
		optimization.pushPipeliningFactor(0);
		
		DFEVar subset0Feedback = UINT64.newInstance(this);
		DFEVar subset0 = isFirstSubset0 ? initialSubset0 : subset0Feedback;
		DFEVar nextSubset0 = nextGospersSubset(subset0);
		subset0Feedback <== stream.offset(nextSubset0, -LOOP_LATENCY);
		
		DFEVar subset1Feedback = UINT64.newInstance(this);
		DFEVar subset1 = isFirstSubset1 ? initialSubset1 : subset1Feedback;
		DFEVar nextSubset1 = nextGospersSubset(subset1);
		subset1Feedback <== stream.offset(nextSubset1, -LOOP_LATENCY);
		
		DFEVar subset2Feedback = UINT64.newInstance(this);
		DFEVar subset2 = isFirstSubset2 ? initialSubset2 : subset2Feedback;
		DFEVar nextSubset2 = nextGospersSubset(subset2);
		subset2Feedback <== stream.offset(nextSubset2, -LOOP_LATENCY);
		
		DFEVar subset3Feedback = UINT64.newInstance(this);
		DFEVar subset3 = isFirstSubset3 ? initialSubset3 : subset3Feedback;
		DFEVar nextSubset3 = nextGospersSubset(subset3);
		subset3Feedback <== stream.offset(nextSubset3, -LOOP_LATENCY);
		
		DFEVar subset = tickModFourIsZero ? subset0 : 
						(tickModFourIsOne ? subset1 : 
						(tickModFourIsTwo ? subset2 : 
											subset3));
		
		DFEVar limit = tickModFourIsZero ? limit0 : 
					   (tickModFourIsOne ? limit1 : 
					   (tickModFourIsTwo ? limit2 : 
						   				   limit3));
		
		DFEVar[] indexes = new DFEVar[K];
		DFEVar remaining = subset;
		for (int i = 0; i < K; ++i) {
			indexes[i] = trailingZeroCount(remaining);
			remaining = remaining & (remaining - 1);
		}
		
		DFEVar isClique = constant.var(BOOL, 1);
		for (int i = 0; i < K; ++i) {
			DFEVar row = lookupRow(adjMatrixRows, indexes[i]);
			DFEVar match = (row & subset) === subset;
			DFEVar idx = constant.var(UINT6, i);
			DFEVar checkBound = (idx < K) ? match : constant.var(BOOL, 1);
			isClique = isClique & checkBound;
		}
		
		DFEVar increment = (isClique === 1 & subset < limit) ?
									 constant.var(UINT64, 1) :
									 constant.var(UINT64, 0); 
		
		DFEVar count0Feedback = UINT64.newInstance(this);
		DFEVar prev0Count = isFirstSubset0 ? constant.var(UINT64, 0) : count0Feedback;
		DFEVar new0Count = prev0Count + (tickModFourIsZero ? increment : constant.var(UINT64, 0)); 
		count0Feedback <== stream.offset(new0Count, -LOOP_LATENCY);
		
		DFEVar count1Feedback = UINT64.newInstance(this);
		DFEVar prev1Count = isFirstSubset1 ? constant.var(UINT64, 0) : count1Feedback;
		DFEVar new1Count = prev1Count + (tickModFourIsOne ? increment : constant.var(UINT64, 0)); 
		count1Feedback <== stream.offset(new1Count, -LOOP_LATENCY);
		
		DFEVar count2Feedback = UINT64.newInstance(this);
		DFEVar prev2Count = isFirstSubset2 ? constant.var(UINT64, 0) : count2Feedback;
		DFEVar new2Count = prev2Count + (tickModFourIsTwo ? increment : constant.var(UINT64, 0)); 
		count2Feedback <== stream.offset(new2Count, -LOOP_LATENCY);
		
		DFEVar count3Feedback = UINT64.newInstance(this);
		DFEVar prev3Count = isFirstSubset3 ? constant.var(UINT64, 0) : count3Feedback;
		DFEVar new3Count = prev3Count + (tickModFourIsThree ? increment : constant.var(UINT64, 0)); 
		count3Feedback <== stream.offset(new3Count, -LOOP_LATENCY);
		
		optimization.popPipeliningFactor();
		
		DFEVar activeCount = tickModFourIsZero ? new0Count : 
							 (tickModFourIsOne ? new1Count : 
							 (tickModFourIsTwo ? new2Count : 
								 				 new3Count));
		
		io.output("cliqueCount", activeCount, UINT64);
	}
	
	public DFEVar trailingZeroCount(DFEVar value) {
		Pair<DFEVar, DFEVar> resultPair = Utility.leading0count(Bitops.bitreverse(value), this, false, false, true); 
		return value === 0 ? 0 : resultPair.getSecond();
	}
	
	public DFEVar nextGospersSubset(DFEVar subset) {
		DFEVar c = subset & (~subset + 1);
		DFEVar r = subset + c;
		DFEVar diff = (subset ^ r) >> 2;
		DFEVar shiftAmount = trailingZeroCount(c);
		DFEVar divByC = Utility.barrelShifter(diff, shiftAmount, false, this);
		return divByC | r;
	}
	
	public DFEVar ctz64(DFEVar value) {
		DFEVar lowest1Bit = value & (~value + 1);
		DFEVar result = constant.var(UINT6, 0);
		for (int i = 0; i < 64; ++i) {
			DFEVar isBitSet = lowest1Bit.slice(i, 1).cast(BOOL);
			DFEVar pos = constant.var(UINT6, i);
			result = result | (isBitSet === 1 ? pos : constant.var(UINT6, 0));
		}
		
		return result;
	}
	
	public DFEVar lookupRow(DFEVector<DFEVar> rows, DFEVar index) {
		DFEVar result = rows[0];
		
		for (int i = 1; i < 64; ++i) {
			result = (index === constant.var(UINT6, i)) ? rows[i] : result;
		}
		
		return result;
	}
}
