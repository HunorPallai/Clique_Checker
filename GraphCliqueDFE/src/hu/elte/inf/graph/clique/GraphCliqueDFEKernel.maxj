package hu.elte.inf.graph.clique;

import com.maxeler.maxcompiler.v2.kernelcompiler.Kernel;
import com.maxeler.maxcompiler.v2.kernelcompiler.KernelParameters;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.base.DFEVar;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.composite.DFEVector;

import static hu.elte.inf.graph.clique.Utility.nextGospersSubset;
import static hu.elte.inf.graph.clique.Utility.trailingZeroCount;
import static hu.elte.inf.graph.clique.Utility.lookupRow;

import static hu.elte.inf.graph.clique.Utility.UINT64;
import static hu.elte.inf.graph.clique.Utility.UINT6;
import static hu.elte.inf.graph.clique.Utility.BOOL;
import static hu.elte.inf.graph.clique.Utility.ADJ_MATRIX_TYPE;

public class GraphCliqueDFEKernel extends Kernel {
	private static final int LOOP_LATENCY = 2;
	private static final int K = 5;

	@SuppressWarnings("deprecation")
	public GraphCliqueDFEKernel(final KernelParameters parameters) {
		super(parameters);

		DFEVar initialSubsetA = io.scalarInput("initialSubsetA", UINT64);
		DFEVar initialSubsetB = io.scalarInput("initialSubsetB", UINT64);
		
		DFEVector<DFEVar> adjMatrixRows = io.input("adjMatrix", ADJ_MATRIX_TYPE);
		
		DFEVar tick = control.count.simpleCounter(64);
		DFEVar isEvenTick = tick.slice(0, 1).cast(BOOL) === 0;
		DFEVar isFirstA = tick === 0;
		DFEVar isFirstB = tick === 1;
		
		optimization.pushPipeliningFactor(0);
		
		DFEVar subsetAFeedback = UINT64.newInstance(this);
		DFEVar subsetA = isFirstA ? initialSubsetA : subsetAFeedback;
		DFEVar nextSubsetA = nextGospersSubset(subsetA, this);
		subsetAFeedback <== stream.offset(nextSubsetA, -LOOP_LATENCY);
		
		DFEVar subsetBFeedback = UINT64.newInstance(this);
		DFEVar subsetB = isFirstB ? initialSubsetB : subsetBFeedback;
		DFEVar nextSubsetB = nextGospersSubset(subsetB, this);
		subsetBFeedback <== stream.offset(nextSubsetB, -LOOP_LATENCY);
		
		DFEVar subset = isEvenTick ? subsetA : subsetB;
		
		DFEVar[] indexes = new DFEVar[K];
		DFEVar remaining = subset;
		for (int i = 0; i < K; ++i) {
			indexes[i] = trailingZeroCount(remaining, this);
			remaining = remaining & (remaining - 1);
		}
		
		DFEVar isClique = constant.var(BOOL, 1);
		for (int i = 0; i < K; ++i) {
			DFEVar row = lookupRow(adjMatrixRows, indexes[i], this);
			DFEVar match = (row & subset) === subset;
			DFEVar idx = constant.var(UINT6, i);
			DFEVar checkBound = (idx < K) ? match : constant.var(BOOL, 1);
			isClique = isClique & checkBound;
		}
		
		DFEVar increment = (isClique === 1) ? constant.var(UINT64, 1) 
											: constant.var(UINT64, 0); 
		
		DFEVar countAFeedback = UINT64.newInstance(this);
		DFEVar prevACount = isFirstA ? constant.var(UINT64, 0) : countAFeedback;
		DFEVar newACount = prevACount + (isEvenTick ? increment : constant.var(UINT64, 0)); 
		countAFeedback <== stream.offset(newACount, -LOOP_LATENCY);
		
		DFEVar countBFeedback = UINT64.newInstance(this);
		DFEVar prevBCount = isFirstB ? constant.var(UINT64, 0) : countBFeedback;
		DFEVar newBCount = prevBCount + (isEvenTick ? constant.var(UINT64, 0) : increment); 
		countBFeedback <== stream.offset(newBCount, -LOOP_LATENCY);
		
		optimization.popPipeliningFactor();
		
		DFEVar activeCount = isEvenTick ? newACount : newBCount;
		
		io.output("cliqueCount", activeCount, UINT64);
	}
}
