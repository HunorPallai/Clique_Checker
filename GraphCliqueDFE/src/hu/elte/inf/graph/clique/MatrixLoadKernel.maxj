package hu.elte.inf.graph.clique;

import com.maxeler.maxcompiler.v2.kernelcompiler.Kernel;
import com.maxeler.maxcompiler.v2.kernelcompiler.KernelParameters;
import com.maxeler.maxcompiler.v2.kernelcompiler.stdlib.Reductions;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.base.DFEVar;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.composite.DFEVector;

import static hu.elte.inf.graph.clique.Utility.UINT64;
import static hu.elte.inf.graph.clique.Utility.UINT32;
import static hu.elte.inf.graph.clique.Utility.ADJ_MATRIX_TYPE;

public class MatrixLoadKernel extends Kernel {
	public static final int NUM_ROWS = 64;
		
	public MatrixLoadKernel(final KernelParameters parameters) {
		super(parameters);
		
		DFEVar loadTickCount = io.scalarInput("loadTickCount", UINT32);
		
		DFEVar tick = control.count.simpleCounter(32);
		DFEVar isLoadPhase = tick < loadTickCount;
		
		DFEVar adjMatrixRow = io.input("adjMatrixRow", UINT64, isLoadPhase);
		
		DFEVector<DFEVar> adjMatrix = ADJ_MATRIX_TYPE.newInstance(this);
		for (int i = 0; i < NUM_ROWS; ++i) {
			DFEVar isRowTick = tick === i;
			adjMatrix[i] <== Reductions.streamHold(adjMatrixRow, isRowTick);
		}
		
		io.output("adjMatrix", adjMatrix, ADJ_MATRIX_TYPE, ~isLoadPhase);
	}
}
