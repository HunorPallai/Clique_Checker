package hu.elte.inf.graph.clique;

import static hu.elte.inf.graph.clique.Utility.UINT64;

import com.maxeler.maxcompiler.v2.kernelcompiler.Kernel;
import com.maxeler.maxcompiler.v2.kernelcompiler.KernelParameters;
import com.maxeler.maxcompiler.v2.kernelcompiler.types.base.DFEVar;

public class ResultCollectorKernel extends Kernel {

	protected ResultCollectorKernel(final KernelParameters parameters, final int numOfKernels, final int startIdx) {
		super(parameters);
		
		DFEVar computeTickCount = io.scalarInput("computeTickCount", UINT64);
		
		DFEVar tick = control.count.simpleCounter(64);
		
		DFEVar isLastFourTick = tick >= computeTickCount - constant.var(UINT64, 4);
		
		DFEVar[] cliqueCounts = new DFEVar[numOfKernels];
		for (int i = 0; i < numOfKernels; ++i) {
			cliqueCounts[i] = io.input("cliqueCount_" + (i + startIdx), UINT64);
		}
		
		
		DFEVar cliqueCount = constant.var(UINT64, 0);
		for (int i = 0; i < numOfKernels; ++i) {
			cliqueCount += cliqueCounts[i];
		}
		
		io.output("cliqueCount", cliqueCount, UINT64, isLastFourTick);
	}

}